{
  "name": "tommy-sdk",
  "version": "0.5.0",
  "author": "Kam Low <support@mytommy.com> (https://mytommy.com)",
  "homepage": "https://mytommy.com",
  "license": "ISC",
  "description": "SDK for building Tommy addons.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "serve": "npm run dev",
    "build": "npm run build-prod",
    "dev": "cross-env NODE_ENV=development node server.js",
    "prod": "cross-env NODE_ENV=production node server.js",
    "build-dev": "cross-env NODE_ENV=development webpack -c ./build/webpack.dev.js",
    "build-prod": "cross-env NODE_ENV=production webpack -c ./build/webpack.prod.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "update:packages": "node scripts/wipe-dependencies.js && rm -rf node_modules && npm update --save-dev && npm update --save",
    "lint:isolation": "eslint --no-eslintrc -c .eslintrc.isolation.js \"addons/**/*.{js,vue}\" \"src/**/*.{js,vue}\" -f json -o eslint-report.json || true",
    "depcruise": "depcruise --config dependency-cruiser.config.js --output-type err-long addons src",
    "depcruise:report": "depcruise --config dependency-cruiser.config.js --output-type json addons src > depcruise-report.json || true",
    "coupling:check": "yarn lint:isolation && yarn depcruise:report && node scripts/compare-to-baseline.js --check eslint-report.json depcruise-report.json coupling-baseline.json",
    "coupling:baseline": "yarn lint:isolation && yarn depcruise:report && node scripts/compare-to-baseline.js --write eslint-report.json depcruise-report.json coupling-baseline.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tommyassociates/tommy-sdk.git"
  },
  "keywords": [
    "tommy",
    "sdk",
    "api"
  ],
  "dependencies": {
    "@fontsource/inter": "^4.5.11",
    "@vitejs/plugin-vue": "^4.2.3",
    "archiver": "^5.3.1",
    "cross-env": "^7.0.3",
    "express": "^4.18.2",
    "glob": "^10.2.1",
    "js-yaml": "^4.1.1",
    "ora": "^5.3.0",
    "request": "^2.88.2",
    "sass": "^1.62.1",
    "tommy-core": "link:../tommy-core",
    "vite": "^4.3.9",
    "vite-express": "^0.9.1",
    "vue": "3.5.11",
    "vuex": "^4.0.2"
  },
  "engines": {
    "node": ">= 6.0.0",
    "npm": ">= 3.0.0"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.3.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.26.0"
  }
}
